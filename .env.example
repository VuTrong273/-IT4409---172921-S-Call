# =====================================================================
# S-Call - Biến môi trường mẫu
#
#   cp .env.example .env        (Windows PowerShell: Copy-Item .env.example .env)
#
# - File `.env` chứa bí mật và đã nằm trong .gitignore: KHÔNG commit.
# - Docker Compose tự đọc `.env` ở thư mục gốc dự án.
# - Mật khẩu/secret chỉ nên dùng chữ và số (không ký tự đặc biệt) vì được ghép vào DATABASE_URL.
# - Giá trị mẫu bên dưới chạy được ngay ở máy cá nhân. Trước khi công khai qua Cloudflare Tunnel,
#   hãy đổi TOÀN BỘ mật khẩu/secret (README).
# =====================================================================

# ---------------------------------------------------------------------
# 1. CHUNG
# ---------------------------------------------------------------------
COMPOSE_PROJECT_NAME=scall
TZ=Asia/Ho_Chi_Minh

# development | production
#  - development: bật GET /dev/emails và trường debugOtp (hiện OTP / mail cảnh báo ngay trên màn hình để DEMO)
#  - production : tắt các tính năng trên
APP_ENV=development

# Địa chỉ CÔNG KHAI mà trình duyệt dùng để mở ứng dụng (không có dấu / ở cuối).
# Backend dùng để ký presigned URL của MinIO và dựng URL ảnh đại diện. PHẢI khớp với thanh địa chỉ trình duyệt.
#   Chạy local        : http://localhost:8080
#   Cloudflare Tunnel : https://scall.ten-mien.com
PUBLIC_URL=http://localhost:8080

# ---------------------------------------------------------------------
# 2. CỔNG TRÊN MÁY CHỦ (host)
# ---------------------------------------------------------------------
# Frontend (nginx) - ĐIỂM VÀO DUY NHẤT của hệ thống: /, /api, /ws, /avatars, /chat-files
FRONTEND_PORT=8080
# Backend gọi trực tiếp để debug (Postman/curl). Người dùng cuối không cần cổng này.
BACKEND_PORT=3000
# PostgreSQL. Dùng 5433 để không đụng PostgreSQL cài sẵn trên máy (5432)
POSTGRES_PORT=5433
# MinIO: S3 API và trang quản trị (Console)
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Vite dev server (chỉ dùng với docker-compose.dev.yml)
FRONTEND_DEV_PORT=5173

# ---------------------------------------------------------------------
# 3. POSTGRESQL
# ---------------------------------------------------------------------
# Các file trong thư mục database/ (000_RelationshipTable.sql, 001_SeedData.sql) tự chạy
# MỘT LẦN khi volume rỗng. Muốn nạp lại: docker compose down -v
POSTGRES_USER=scall
POSTGRES_PASSWORD=scall_dev_password
POSTGRES_DB=scall

# ---------------------------------------------------------------------
# 4. MINIO (lưu ảnh đại diện, ảnh và tệp trong chat)
# ---------------------------------------------------------------------
MINIO_ROOT_USER=scall_minio
MINIO_ROOT_PASSWORD=scall_minio_password
# Tên bucket phải khớp với cột `attachments.bucket` trong CSDL và thư mục docker/minio/seed/
MINIO_BUCKET_AVATARS=avatars
MINIO_BUCKET_CHAT=chat-files
# Nạp ảnh/tệp mẫu của Seed Data vào MinIO khi khởi động (true/false)
MINIO_SEED_DEMO=true
# URL mà TRÌNH DUYỆT dùng để tải tệp (presigned URL). Mặc định cùng origin với frontend.
MINIO_PUBLIC_URL=${PUBLIC_URL}
# Thời hạn presigned URL tải tệp (giây)
MINIO_PRESIGN_TTL_SECONDS=3600

# ---------------------------------------------------------------------
# 5. XÁC THỰC & BẢO MẬT
# ---------------------------------------------------------------------
# Ba secret KHÁC NHAU, mỗi cái >= 32 ký tự ngẫu nhiên
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789abcdef
WS_TICKET_SECRET=dev-ws-ticket-secret-change-me-0123456789abcdef
UNLOCK_TOKEN_SECRET=dev-unlock-secret-change-me-0123456789abcdef

JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
WS_TICKET_TTL_SECONDS=60
UNLOCK_TOKEN_TTL_SECONDS=900
BCRYPT_COST=10

# OTP quên mật khẩu (6 chữ số)
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
# Khóa cuộc trò chuyện bằng PIN 4 số: sai quá số lần sẽ bị khóa thử tạm thời
PIN_MAX_ATTEMPTS=5
PIN_LOCK_MINUTES=5

# ---------------------------------------------------------------------
# 6. EMAIL (OTP quên mật khẩu, cảnh báo Super Admin đăng nhập)
# ---------------------------------------------------------------------
# dev : không gửi SMTP, chỉ ghi bảng email_outbox, xem qua GET /dev/emails
# smtp: gửi thật qua SMTP bên dưới
MAIL_MODE=dev
MAIL_FROM=S-Call <no-reply@scall.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---------------------------------------------------------------------
# 7. TỆP TẢI LÊN & CUỘC GỌI
# ---------------------------------------------------------------------
MAX_UPLOAD_MB=20
AVATAR_MAX_MB=5
# Quá thời gian đổ chuông -> cuộc gọi nhỡ
CALL_RING_TIMEOUT_SECONDS=30
# Mất kết nối WebSocket khi đang gọi: chờ kết nối lại trước khi kết thúc cuộc gọi
CALL_RECONNECT_GRACE_SECONDS=10

# ---------------------------------------------------------------------
# 8. STUN / TURN (WebRTC)
# ---------------------------------------------------------------------
# coturn  : dùng container Coturn trong docker-compose (bắt buộc mở cổng UDP trên router/firewall, xem README)
# metered : dùng dịch vụ Metered.ca (điền METERED_*), không cần mở cổng UDP, nên dùng khi demo qua Cloudflare Tunnel
# none    : chỉ dùng STUN (chỉ chạy được khi hai máy cùng mạng/NAT dễ)
TURN_MODE=coturn

STUN_URLS=stun:stun.l.google.com:19302

# ----- Coturn -----
# Realm và secret dùng chung giữa backend (sinh credential tạm) và Coturn (--use-auth-secret)
TURN_REALM=scall.local
TURN_SECRET=dev-turn-secret-change-me-0123456789abcdef
# IP CÔNG KHAI của máy chạy Coturn (để trống nếu chỉ thử trong mạng nội bộ/localhost)
TURN_EXTERNAL_IP=
TURN_PORT=3478
# Dải cổng UDP relay (mở cả dải này trên firewall/router, đủ cho vài chục cuộc gọi)
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
# Địa chỉ TURN mà TRÌNH DUYỆT kết nối tới, phân cách bằng dấu phẩy.
# Máy khác mạng phải dùng IP/tên miền công khai, ví dụ: turn:turn.ten-mien-cua-ban.com:3478?transport=udp
TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp
TURN_CREDENTIAL_TTL_SECONDS=3600

# ----- Metered.ca (khi TURN_MODE=metered) -----
METERED_APP_NAME=
METERED_API_KEY=

# ---------------------------------------------------------------------
# 9. CLOUDFLARE TUNNEL (docker compose --profile tunnel up -d)
# ---------------------------------------------------------------------
# Token lấy ở Cloudflare Zero Trust > Networks > Tunnels > <tunnel của bạn> > Configure
CLOUDFLARE_TUNNEL_TOKEN=