# Thống nhất xuống dòng LF cho mọi file văn bản (tránh lỗi "\r" khi chạy script/Dockerfile trong container Linux
# do thành viên dùng Windows). Git tự chuyển đổi khi checkout/commit.
* text=auto eol=lf

# Tệp nhị phân: không đụng tới
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.woff binary
*.woff2 binary
