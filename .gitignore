# =====================================================================
# S-Call .gitignore  (Node.js, Docker, IDE, biến môi trường)
# =====================================================================

# ---------------------------------------------------------------------
# Biến môi trường (DB password, JWT secret, MinIO key, TURN secret, Cloudflare token)
# ---------------------------------------------------------------------
.env
.env.*
!.env.example

# Chứng chỉ, khóa riêng, thông tin đăng nhập Cloudflare Tunnel
*.pem
*.key
*.crt
*.p12
credentials.json
cert.pem
.cloudflared/

# ---------------------------------------------------------------------
# Node.js (backend/ và frontend/)
# ---------------------------------------------------------------------
node_modules/
jspm_packages/
# Giữ lại package-lock.json (Dockerfile dùng `npm ci`), không commit lockfile của trình quản lý khác
yarn.lock
pnpm-lock.yaml

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm/
.eslintcache
.stylelintcache
*.tsbuildinfo
.node_repl_history

# Thư mục build / cache của framework
dist/
dist-ssr/
build/
out/
.next/
.nuxt/
.vite/
.parcel-cache/
.turbo/
.cache/

# Kiểm thử / độ phủ
coverage/
.nyc_output/
test-results/
playwright-report/

# Logs
logs/
*.log

# ---------------------------------------------------------------------
# Docker
# ---------------------------------------------------------------------
# Dữ liệu chạy thật nếu bind-mount ra thư mục (mặc định dùng named volume nên không có)
docker/**/data/
pgdata/
miniodata/
docker-compose.override.yml
*.pid

# ---------------------------------------------------------------------
# IDE / Editor
# ---------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.project
.classpath
.settings/
.history/

# ---------------------------------------------------------------------
# Hệ điều hành
# ---------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------------------------------------------------------------------
# Tệp tạm
# ---------------------------------------------------------------------
tmp/
temp/
*.tmp
*.bak